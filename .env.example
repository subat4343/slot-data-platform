# .env にコピーして使う（.env は git 管理外）
SLOT_DATA_DATABASE_URL=postgresql+psycopg://postgres@localhost:55432/slot_data
SLOT_DATA_TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:55432/slot_data_test
SLOT_DATA_RAW_STORE_ROOT=var/rawstore
SLOT_DATA_CONFIG_PATH=config/app.yaml
SLOT_DATA_LOG_LEVEL=INFO
# pg_dump / pg_restore が PATH に無い場合（scripts/dev-postgres.ps1 を使う場合は .devdb/pgsql/bin）
# SLOT_DATA_PG_BIN_DIR=.devdb/pgsql/bin
# docker compose 用
POSTGRES_PASSWORD=change-me
